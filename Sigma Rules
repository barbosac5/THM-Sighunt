date: 5/18/2026
modified: 5/18/2026
logsource:
  product: windows
  service: sysmon
detection:
  selection:
    EventID: 1 
    Image: C:\Windows\SysWOW64\mshta.exe
    ParentImage: C:\Program Files\Google\Chrome\Application\chrome.exe
