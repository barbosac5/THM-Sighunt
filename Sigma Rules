level: medium 
tags: #Associated TTPs from MITRE ATT&CK
  - attack.credential_access #MITRE Tactic
  - attack.t1110 #MITRE Technique



# Challenge 2: certutil_file_ingress.yml
title: Certutil Download
id: d7df4ff9-8981-4875-9799-798fcfd12bf3
status: experimental 
description: Execution of Certutil tool to download Netcat binary.
author: barbosac5
date: 5/18/2026
modified: 5/18/2026
logsource:
  product: windows
  service: process_creation
detection:
  selection:
    EventID: 1 
    Image|endswith:
     - '\certutil.exe'
    CommandLine|contains:
     - '-urlcache'
     - '-split'
     - '-f'
  condition: selection  
fields:
falsepositives:
level: medium 


